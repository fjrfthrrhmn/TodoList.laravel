        "/api/project/store": {
            "post": {
                "tags": [
                    "Projects"
                ],
                "summary": "Membuat project baru",
                "operationId": "30bbba47b6c1186982bf206d15a1162b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "description",
                                    "deadline"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Membuat UI Dashboard"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Bikin desain UI dashboard utama"
                                    },
                                    "icon": {
                                        "type": "string",
                                        "example": "📝"
                                    },
                                    "priority": {
                                        "type": "string",
                                        "enum": [
                                            "low",
                                            "medium",
                                            "high",
                                            "urgent"
                                        ],
                                        "example": "medium"
                                    },
                                    "deadline": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2025-12-31"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Berhasil"
                    },
                    "500": {
                        "description": "Terjadi Kesalahan pada Server"
                    }
                }
            }
        },
